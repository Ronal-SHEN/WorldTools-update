{
  "schemaVersion": 1,
  "id": "worldtools",
  "version": "${version}",
  "name": "WorldTools",
  "description": "Download a server's world as a detailed singleplayer world. An updated fork of WorldTools.",
  "authors": [
    "Constructor",
    "P529",
    "rfresh"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/worldtools-update",
    "sources": "https://github.com/Ronal-SHEN/WorldTools-update/",
    "issues": "https://github.com/Ronal-SHEN/WorldTools-update/issues"
  },
  "license": "GNU General Public License v3.0",
  "icon": "assets/worldtools/WorldTools.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "org.waste.of.time.fabric.WorldToolsFabric"
      }
    ],
    "modmenu": [
      "org.waste.of.time.fabric.WorldToolsModMenuIntegration"
    ]
  },
  "mixins": [
    "worldtools.mixins.common.json",
    "worldtools.mixins.fabric.json"
  ],
  "accessWidener": "worldtools.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": [">=26.2 <26.3"],
    "java": ">=25",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "cloth-config": ">=15"
  }
}
